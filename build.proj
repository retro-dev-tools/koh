<!--
  Repo-level build targets. Invoke with `dotnet msbuild build.proj -t:<Target>`.
  No external tooling required — MSBuild ships with the .NET SDK.

  Quick reference:
    dotnet msbuild build.proj -t:Test      (fast suite — no Koh.Compiler.Tests)
    dotnet msbuild build.proj -t:TestAll   (everything; needs RAM, see below)
    dotnet msbuild build.proj -t:Benchmark
    dotnet msbuild build.proj -t:PublishDev
    dotnet msbuild build.proj -t:PublishEmulatorApp
    dotnet msbuild build.proj -t:RunEmulator   (publish + launch Koh.Emulator.App)
-->
<Project DefaultTargets="Test">

  <PropertyGroup>
    <EmulatorRuntimeIdentifier Condition="'$(EmulatorRuntimeIdentifier)' == ''">win-x64</EmulatorRuntimeIdentifier>
    <EmulatorPublishDir>$(MSBuildThisFileDirectory)src\Emulator\Koh.Emulator.App\bin\Release\net10.0\$(EmulatorRuntimeIdentifier)\publish</EmulatorPublishDir>
  </PropertyGroup>

  <!--
    Test is the DEFAULT development loop and deliberately excludes Koh.Compiler.Tests.
    That project's 522 cases each Roslyn-compile a source fixture to a real assembly on
    disk and then run an emulator over the result; run in parallel they exhaust memory on
    a normal desktop and take the machine down with them. Everything else in the repo is
    ordinary unit testing — Koh.Core.Tests has twice as many cases and finishes in
    seconds.

    Use TestAll before pushing, or when touching the compiler. It is what CI runs.
  -->
  <Target Name="Test">
    <!-- The solution flag is required: a bare positional arg is ambiguous to the .NET 10 SDK's
         `dotnet test` when the repo root has multiple sln/slnf files (see ci.yml, fixed the same way). -->
    <Exec Command="dotnet test --solution Koh.Fast.slnf" />
  </Target>

  <Target Name="TestAll">
    <Exec Command="dotnet test --solution Koh.Ci.slnf" />
  </Target>

  <!--
    The CompatTests target is gone: tests/Koh.Compat.Tests is disabled entirely for
    now. It is out of the solution and out of CI, and its sources stay on disk.
    See tests/Koh.Compat.Tests/README.md for what re-enabling involves.
  -->

  <Target Name="Benchmark">
    <Exec Command="dotnet run --project tools/benchmarks/Koh.Benchmarks/ --configuration Release" />
  </Target>

  <Target Name="PublishDev">
    <!-- LSP server for F5 debugging of the VS Code extension. -->
    <Exec Command="dotnet publish src/Asm/Koh.Lsp -c Debug -o editors/vscode/server" />
  </Target>

  <Target Name="PublishEmulatorApp">
    <!-- NativeAOT publish of the KohUI-based emulator. -->
    <Exec Command="dotnet publish src/Emulator/Koh.Emulator.App -c Release -r $(EmulatorRuntimeIdentifier)" />
  </Target>

  <Target Name="RunEmulator" DependsOnTargets="PublishEmulatorApp">
    <Exec Command="&quot;$(EmulatorPublishDir)\Koh.Emulator.App.exe&quot;" />
  </Target>

  <Target Name="BuildSample2048">
    <MakeDir Directories="samples/asm/gb-2048/build" />
    <Exec Command="dotnet run --project src/Asm/Koh.Asm -- samples/asm/gb-2048/src/main.asm -o samples/asm/gb-2048/build/2048.kobj" />
    <Exec Command="dotnet run --project src/Link/Koh.Link -- samples/asm/gb-2048/build/2048.kobj -o samples/asm/gb-2048/build/2048.gbc -n samples/asm/gb-2048/build/2048.sym" />
    <Error Condition="!Exists('samples/asm/gb-2048/build/2048.gbc')" Text="2048.gbc was not produced" />
    <Message Importance="high" Text="Built samples/asm/gb-2048/build/2048.gbc" />
  </Target>

</Project>
