<!--
  Repo-level build targets. Invoke with `dotnet msbuild build.proj -t:<Target>`.
  Requirements: .NET 10 SDK, Rust/Cargo, Python 3.11+

  Quick reference:
    dotnet msbuild build.proj -t:Test      (.NET component tests)
    dotnet msbuild build.proj -t:TestAll   (Rust and .NET tests)
    dotnet msbuild build.proj -t:Benchmark
    dotnet msbuild build.proj -t:PublishDev
    dotnet msbuild build.proj -t:PublishEmulatorApp
    dotnet msbuild build.proj -t:RunEmulator   (publish + launch koh-emulator)
-->
<Project DefaultTargets="Test">

  <PropertyGroup>
    <EmulatorRuntimeIdentifier Condition="'$(EmulatorRuntimeIdentifier)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</EmulatorRuntimeIdentifier>
    <EmulatorPublishDir Condition="'$(EmulatorPublishDir)' == ''">$(MSBuildThisFileDirectory)src/Emulator/Koh.Emulator.App/bin/Release/net10.0/$(EmulatorRuntimeIdentifier)/publish</EmulatorPublishDir>
    <EmulatorExecutableName>koh-emulator</EmulatorExecutableName>
    <EmulatorExecutableName Condition="$(EmulatorRuntimeIdentifier.StartsWith('win-'))">koh-emulator.exe</EmulatorExecutableName>
  </PropertyGroup>

  <Target Name="Test">
    <!-- The solution flag is required: a bare positional arg is ambiguous to the .NET 10 SDK's
         `dotnet test` when the repo root has multiple sln/slnf files (see ci.yml, fixed the same way). -->
    <Exec Command="dotnet test --solution Koh.Fast.slnf" />
  </Target>

  <Target Name="TestAll">
    <Exec Command="cargo nextest run --workspace --all-features --locked" />
    <Exec Command="cargo test --workspace --all-features --doc --locked" />
    <Exec Command="dotnet test --solution Koh.Ci.slnf" />
  </Target>

  <Target Name="Benchmark">
    <Exec Command="dotnet run --project tools/benchmarks/Koh.Benchmarks/ --configuration Release" />
  </Target>

  <Target Name="PublishDev" DependsOnTargets="PublishEmulatorApp">
    <Exec Command="dotnet publish src/Asm/Koh.Lsp -c Debug -o editors/vscode/server" />
    <ItemGroup>
      <DesktopPublishFiles Include="$(EmulatorPublishDir)/**/*" Exclude="$(EmulatorPublishDir)/**/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DesktopPublishFiles)" DestinationFiles="@(DesktopPublishFiles->'$(MSBuildThisFileDirectory)editors/vscode/server/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="BuildRustDesktop">
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeUiPath" Properties="Configuration=Release;RuntimeIdentifier=$(EmulatorRuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" PropertyName="RustDesktop" />
    </MSBuild>
  </Target>

  <Target Name="PublishEmulatorApp" DependsOnTargets="BuildRustDesktop">
    <Exec Command="dotnet publish src/Emulator/Koh.Emulator.App -c Release -r $(EmulatorRuntimeIdentifier) -o &quot;$(EmulatorPublishDir)&quot;" />
    <ItemGroup>
      <RetiredDesktopOutputs Include="$(EmulatorPublishDir)/KohUI*.dll;$(EmulatorPublishDir)/KohUI*.pdb;$(EmulatorPublishDir)/SDL3-CS.dll;$(EmulatorPublishDir)/SDL3.dll;$(EmulatorPublishDir)/libSDL3*.so*;$(EmulatorPublishDir)/libSDL3*.dylib;$(EmulatorPublishDir)/licenses/SDL3*.txt" />
    </ItemGroup>
    <Delete Files="@(RetiredDesktopOutputs)" />
    <Copy SourceFiles="$(RustDesktop)" DestinationFolder="$(EmulatorPublishDir)" />
    <ItemGroup>
      <RustUiNotices Include="$(MSBuildThisFileDirectory)licenses/rust-ui/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RustUiNotices)" DestinationFiles="@(RustUiNotices->'$(EmulatorPublishDir)/licenses/rust-ui/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)scripts/stage-rust-notices.py&quot; &quot;$(EmulatorPublishDir)/licenses/rust-runtime&quot;" />
  </Target>

  <Target Name="RunEmulator" DependsOnTargets="PublishEmulatorApp">
    <Exec Command="&quot;$(EmulatorPublishDir)/$(EmulatorExecutableName)&quot;" />
  </Target>

  <Target Name="BuildRustAssembler">
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeAssemblerPath" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" PropertyName="RustAssembler" />
    </MSBuild>
  </Target>

  <Target Name="TestRustAssembler">
    <Exec Command="cargo nextest run --workspace --all-features --locked" />
    <Exec Command="cargo test --workspace --all-features --doc --locked" />
  </Target>

  <Target Name="BuildRustLinker">
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeLinkerPath" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" PropertyName="RustLinker" />
    </MSBuild>
  </Target>

  <Target Name="BuildSample2048Rust" DependsOnTargets="BuildRustAssembler;BuildRustLinker">
    <MakeDir Directories="samples/asm/gb-2048/build" />
    <Exec Command="&quot;$(RustAssembler)&quot; samples/asm/gb-2048/src/main.asm -o samples/asm/gb-2048/build/2048-rust.o" />
    <Exec Command="&quot;$(RustLinker)&quot; samples/asm/gb-2048/build/2048-rust.o -o samples/asm/gb-2048/build/2048-rust.gbc -n samples/asm/gb-2048/build/2048-rust.sym -d samples/asm/gb-2048/build/2048-rust.elf" />
    <Error Condition="!Exists('samples/asm/gb-2048/build/2048-rust.gbc')" Text="2048-rust.gbc was not produced" />
  </Target>

  <Target Name="BuildSample2048" DependsOnTargets="BuildRustAssembler;BuildRustLinker">
    <MakeDir Directories="samples/asm/gb-2048/build" />
    <Exec Command="&quot;$(RustAssembler)&quot; samples/asm/gb-2048/src/main.asm -o samples/asm/gb-2048/build/2048.o" />
    <Exec Command="&quot;$(RustLinker)&quot; samples/asm/gb-2048/build/2048.o -o samples/asm/gb-2048/build/2048.gbc -n samples/asm/gb-2048/build/2048.sym -d samples/asm/gb-2048/build/2048.elf" />
    <Error Condition="!Exists('samples/asm/gb-2048/build/2048.gbc')" Text="2048.gbc was not produced" />
    <Message Importance="high" Text="Built samples/asm/gb-2048/build/2048.gbc" />
  </Target>

</Project>
