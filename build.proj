<!--
  Repo-level build targets. Invoke with `dotnet msbuild build.proj -t:<Target>`.
  Requirements: .NET 10 SDK, Rust/Cargo, Python 3.11+

  Quick reference:
    dotnet msbuild build.proj -t:Test      (.NET component tests)
    dotnet msbuild build.proj -t:PublishDev
    dotnet msbuild build.proj -t:PublishEmulatorApp
-->
<Project DefaultTargets="Test">

  <PropertyGroup>
    <EmulatorRuntimeIdentifier Condition="'$(EmulatorRuntimeIdentifier)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</EmulatorRuntimeIdentifier>
    <EmulatorPublishDir Condition="'$(EmulatorPublishDir)' == ''">$(MSBuildThisFileDirectory)artifacts/emulator/$(EmulatorRuntimeIdentifier)</EmulatorPublishDir>
    <LanguageServerRuntimeIdentifier Condition="'$(LanguageServerRuntimeIdentifier)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</LanguageServerRuntimeIdentifier>
    <LanguageServerPublishDir Condition="'$(LanguageServerPublishDir)' == ''">$(MSBuildThisFileDirectory)artifacts/language-server/$(LanguageServerRuntimeIdentifier)</LanguageServerPublishDir>
  </PropertyGroup>

  <Target Name="Test">
    <Exec Command="dotnet test --solution Koh.Fast.slnf" />
  </Target>

  <Target Name="PublishDev" DependsOnTargets="PublishEmulatorApp">
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="PublishLanguageServer" Properties="LanguageServerPublishDir=$(MSBuildThisFileDirectory)editors/vscode/server" />
    <ItemGroup>
      <RetiredDevEngineOutputs Include="editors/vscode/server/Koh.Emulator.App*;editors/vscode/server/Koh.Emulator.dll;editors/vscode/server/Koh.Debugger.dll;editors/vscode/server/Koh.Boot.dll;editors/vscode/server/Silk.NET.OpenAL.dll;editors/vscode/server/Silk.NET.Core.dll" />
      <DesktopPublishFiles Include="$(EmulatorPublishDir)/**/*" Exclude="$(EmulatorPublishDir)/**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(RetiredDevEngineOutputs)" />
    <Copy SourceFiles="@(DesktopPublishFiles)" DestinationFiles="@(DesktopPublishFiles->'$(MSBuildThisFileDirectory)editors/vscode/server/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishLanguageServer">
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeLanguageServerFiles" Properties="Configuration=Release;RuntimeIdentifier=$(LanguageServerRuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="LanguageServerFiles" />
    </MSBuild>
    <Copy SourceFiles="@(LanguageServerFiles)" DestinationFolder="$(LanguageServerPublishDir)" />
    <ItemGroup>
      <LanguageServerNotices Include="licenses/rust-ui/**/*;licenses/rust-assembler/**/*;licenses/rust-lsp/**/*;licenses/rust-assembler-dependencies.md" />
      <RetiredLanguageServerFiles Include="$(LanguageServerPublishDir)/koh-lsp.dll;$(LanguageServerPublishDir)/koh-lsp.pdb;$(LanguageServerPublishDir)/koh-lsp.deps.json;$(LanguageServerPublishDir)/koh-lsp.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(RetiredLanguageServerFiles)" />
    <Copy SourceFiles="@(LanguageServerNotices)" DestinationFiles="@(LanguageServerNotices->'$(LanguageServerPublishDir)/%(Identity)')" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)scripts/stage-rust-notices.py&quot; &quot;$(LanguageServerPublishDir)/licenses/rust-runtime&quot;" />
  </Target>

  <Target Name="BuildRustDesktop">
    <Exec Command="dotnet restore src/Asm/Koh.Native/Koh.Native.csproj -r $(EmulatorRuntimeIdentifier)" />
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeUiPath" Properties="Configuration=Release;RuntimeIdentifier=$(EmulatorRuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" PropertyName="RustDesktop" />
    </MSBuild>
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeEnginePath;GetNativeAudioFiles" Properties="Configuration=Release;RuntimeIdentifier=$(EmulatorRuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="NativeEngineFiles" />
    </MSBuild>
  </Target>

  <Target Name="PublishEmulatorApp" DependsOnTargets="BuildRustDesktop">
    <ItemGroup>
      <RetiredDesktopOutputs Include="$(EmulatorPublishDir)/KohUI*.dll;$(EmulatorPublishDir)/KohUI*.pdb;$(EmulatorPublishDir)/SDL3-CS.dll;$(EmulatorPublishDir)/SDL3.dll;$(EmulatorPublishDir)/libSDL3*.so*;$(EmulatorPublishDir)/libSDL3*.dylib;$(EmulatorPublishDir)/licenses/SDL3*.txt" />
      <RetiredDesktopOutputs Include="$(EmulatorPublishDir)/Koh.Emulator.App*;$(EmulatorPublishDir)/Koh.Emulator.dll;$(EmulatorPublishDir)/Koh.Debugger.dll;$(EmulatorPublishDir)/Koh.Boot.dll;$(EmulatorPublishDir)/Silk.NET.OpenAL.dll;$(EmulatorPublishDir)/Silk.NET.Core.dll" />
    </ItemGroup>
    <Delete Files="@(RetiredDesktopOutputs)" />
    <Copy SourceFiles="$(RustDesktop)" DestinationFolder="$(EmulatorPublishDir)" />
    <Copy SourceFiles="@(NativeEngineFiles)" DestinationFolder="$(EmulatorPublishDir)" />
    <ItemGroup>
      <RustUiNotices Include="$(MSBuildThisFileDirectory)licenses/rust-ui/**/*" />
      <RustAssemblerNotices Include="$(MSBuildThisFileDirectory)licenses/rust-assembler/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RustUiNotices)" DestinationFiles="@(RustUiNotices->'$(EmulatorPublishDir)/licenses/rust-ui/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(RustAssemblerNotices)" DestinationFiles="@(RustAssemblerNotices->'$(EmulatorPublishDir)/licenses/rust-assembler/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)licenses/rust-assembler-dependencies.md" DestinationFolder="$(EmulatorPublishDir)/licenses" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)scripts/stage-rust-notices.py&quot; &quot;$(EmulatorPublishDir)/licenses/rust-runtime&quot;" />
  </Target>

  <Target Name="BuildRustAssembler">
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeAssemblerPath" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" PropertyName="RustAssembler" />
    </MSBuild>
  </Target>

  <Target Name="BuildRustLinker">
    <MSBuild Projects="src/Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeLinkerPath" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" PropertyName="RustLinker" />
    </MSBuild>
  </Target>

  <Target Name="BuildSample2048" DependsOnTargets="BuildRustAssembler;BuildRustLinker">
    <MakeDir Directories="samples/asm/gb-2048/build" />
    <Exec Command="&quot;$(RustAssembler)&quot; samples/asm/gb-2048/src/main.asm -o samples/asm/gb-2048/build/2048.o" />
    <Exec Command="&quot;$(RustLinker)&quot; samples/asm/gb-2048/build/2048.o -o samples/asm/gb-2048/build/2048.gbc -n samples/asm/gb-2048/build/2048.sym -d samples/asm/gb-2048/build/2048.elf" />
    <Error Condition="!Exists('samples/asm/gb-2048/build/2048.gbc')" Text="2048.gbc was not produced" />
    <Message Importance="high" Text="Built samples/asm/gb-2048/build/2048.gbc" />
  </Target>

</Project>
