<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../Asm/Koh.Native/Koh.Native.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../../Link/Koh.Link/Koh.Link.csproj" ReferenceOutputAssembly="false" />
    <None Include="*.asm" />
    <None Include="*.inc" />
  </ItemGroup>
  <Target Name="ResolveKohTools">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../Asm/Koh.Native/Koh.Native.csproj" Targets="GetNativeHostAssemblerPath">
      <Output TaskParameter="TargetOutputs" PropertyName="KohAsmPath" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../Link/Koh.Link/Koh.Link.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="KohLinkDll" />
    </MSBuild>
  </Target>
  <Target Name="AssembleBootRoms" AfterTargets="ResolveProjectReferences" DependsOnTargets="ResolveKohTools"
          Inputs="@(None);$(KohAsmPath);$(KohLinkDll)" Outputs="$(IntermediateOutputPath)dmg_boot.bin;$(IntermediateOutputPath)cgb_boot.bin">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(KohAsmPath)&quot; dmg_boot.asm -o &quot;$(IntermediateOutputPath)dmg_boot.kobj&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec Command="dotnet exec &quot;$(KohLinkDll)&quot; &quot;$(IntermediateOutputPath)dmg_boot.kobj&quot; -o &quot;$(IntermediateOutputPath)dmg_boot.bin&quot; --raw --size=100" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec Command="&quot;$(KohAsmPath)&quot; cgb_boot.asm -o &quot;$(IntermediateOutputPath)cgb_boot.kobj&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec Command="dotnet exec &quot;$(KohLinkDll)&quot; &quot;$(IntermediateOutputPath)cgb_boot.kobj&quot; -o &quot;$(IntermediateOutputPath)cgb_boot.bin&quot; --raw --size=900" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
  <Target Name="EmbedBootRoms" AfterTargets="AssembleBootRoms" BeforeTargets="CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)dmg_boot.bin" LogicalName="Koh.Boot.dmg_boot.bin" />
      <EmbeddedResource Include="$(IntermediateOutputPath)cgb_boot.bin" LogicalName="Koh.Boot.cgb_boot.bin" />
    </ItemGroup>
  </Target>
</Project>
