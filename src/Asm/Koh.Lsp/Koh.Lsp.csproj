<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>koh-lsp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koh.Lsp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koh.Native\Koh.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <Target Name="PublishNativeWorkerForRuntime" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Koh.Native/Koh.Native.csproj" Targets="GetNativeAssemblerPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" PropertyName="KohPublishedNativeWorker" />
    </MSBuild>
    <PropertyGroup>
      <KohPublishedWorkerName>koh-asm</KohPublishedWorkerName>
      <KohPublishedWorkerName Condition="$(RuntimeIdentifier.StartsWith('win-'))">koh-asm.exe</KohPublishedWorkerName>
      <KohHostWorkerName>koh-asm</KohHostWorkerName>
      <KohHostWorkerName Condition="'$(OS)' == 'Windows_NT'">koh-asm.exe</KohHostWorkerName>
    </PropertyGroup>
    <Copy SourceFiles="$(KohPublishedNativeWorker)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Delete Files="$(PublishDir)/$(KohHostWorkerName)" Condition="'$(KohHostWorkerName)' != '$(KohPublishedWorkerName)'" />
  </Target>

</Project>
