<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <KohRomName Condition="'$(KohRomName)' == ''">$(AssemblyName).gb</KohRomName>
    <KohRomPath Condition="'$(KohRomPath)' == ''">$(MSBuildProjectDirectory)/$(KohRomName)</KohRomPath>
    <KohObjectPath Condition="'$(KohObjectPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(AssemblyName).o'))</KohObjectPath>
    <KohCgbCompatible Condition="'$(KohCgbCompatible)' == ''">false</KohCgbCompatible>
    <KohCgbOnly Condition="'$(KohCgbOnly)' == ''">false</KohCgbOnly>
    <KohEmitDebugInfo Condition="'$(KohEmitDebugInfo)' == ''">true</KohEmitDebugInfo>
    <KohKdbgPath>$([System.IO.Path]::ChangeExtension('$(KohRomPath)', '.kdbg'))</KohKdbgPath>
    <KohKdbgOutput Condition="'$(KohEmitDebugInfo)' == 'true'">$(KohKdbgPath)</KohKdbgOutput>
    <KohBuildTasksProject>$(KohRoot)src/Compiler/Koh.Build.Tasks/Koh.Build.Tasks.csproj</KohBuildTasksProject>
    <KohBuildTasksAssembly>$(KohRoot)src/Compiler/Koh.Build.Tasks/bin/$(Configuration)/net10.0/Koh.Build.Tasks.dll</KohBuildTasksAssembly>
    <KohNativeSuffix Condition="'$(OS)' == 'Windows_NT'">.exe</KohNativeSuffix>
    <KohCompilerExecutable Condition="'$(KohCompilerExecutable)' == '' and '$(KOH_COMPILE)' != ''">$(KOH_COMPILE)</KohCompilerExecutable>
    <KohCompilerExecutable Condition="'$(KohCompilerExecutable)' == ''">$([System.IO.Path]::GetDirectoryName('$(KohBuildTasksAssembly)'))/koh-compile$(KohNativeSuffix)</KohCompilerExecutable>
    <KohLinkExecutable Condition="'$(KohLinkExecutable)' == '' and '$(KOH_LINK)' != ''">$(KOH_LINK)</KohLinkExecutable>
    <KohLinkExecutable Condition="'$(KohLinkExecutable)' == ''">$([System.IO.Path]::GetDirectoryName('$(KohBuildTasksAssembly)'))/koh-link$(KohNativeSuffix)</KohLinkExecutable>
    <KohEmulatorProject>$(KohRoot)src/Emulator/Koh.Emulator.App/Koh.Emulator.App.csproj</KohEmulatorProject>
    <KohAbsoluteRomPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(KohRomPath)'))</KohAbsoluteRomPath>
    <RunCommand>dotnet</RunCommand>
    <RunArguments>run --project "$(KohEmulatorProject)" --configuration "$(Configuration)" -- "$(KohAbsoluteRomPath)"</RunArguments>
    <KohTileSheetsFile>$(IntermediateOutputPath)KohTileSheets.g.cs</KohTileSheetsFile>
    <KohRomPropsStampFile>$(IntermediateOutputPath)Koh.CompileKohRom.props.txt</KohRomPropsStampFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(KohBuildTasksProject)" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;_IsPublishing;PublishAot" />
  </ItemGroup>

  <UsingTask TaskName="Koh.Build.Tasks.CompileKohRom" AssemblyFile="$(KohBuildTasksAssembly)" />
  <UsingTask TaskName="Koh.Build.Tasks.GenerateKohTileSheets" AssemblyFile="$(KohBuildTasksAssembly)" />

  <Target Name="KohGenerateTileSheets" DependsOnTargets="ResolveProjectReferences"
          Condition="'@(KohTileSheet)' != ''"
          Inputs="@(KohTileSheet);$(KohBuildTasksAssembly)" Outputs="$(KohTileSheetsFile)">
    <GenerateKohTileSheets Sheets="@(KohTileSheet)" OutputFile="$(KohTileSheetsFile)" Namespace="$(RootNamespace)" />
  </Target>

  <Target Name="KohIncludeTileSheets" BeforeTargets="CoreCompile" DependsOnTargets="KohGenerateTileSheets" Condition="'@(KohTileSheet)' != ''">
    <ItemGroup>
      <Compile Include="$(KohTileSheetsFile)" />
      <FileWrites Include="$(KohTileSheetsFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_KohWriteRomPropsStamp">
    <ItemGroup>
      <_KohRomProps Include="CgbCompatible=$(KohCgbCompatible)" />
      <_KohRomProps Include="CgbOnly=$(KohCgbOnly)" />
      <_KohRomProps Include="OutputPath=$(KohRomPath)" />
      <_KohRomProps Include="ObjectPath=$(KohObjectPath)" />
      <_KohRomProps Include="EmitDebugInfo=$(KohEmitDebugInfo)" />
      <_KohRomProps Include="CompilerPath=$(KohCompilerExecutable)" />
      <_KohRomProps Include="LinkerPath=$(KohLinkExecutable)" />
    </ItemGroup>
    <WriteLinesToFile File="$(KohRomPropsStampFile)" Lines="@(_KohRomProps)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(KohRomPropsStampFile)" />
    </ItemGroup>
  </Target>

  <Target Name="CompileKohRom" AfterTargets="Build" DependsOnTargets="_KohWriteRomPropsStamp"
          Inputs="$(TargetPath);@(ReferencePath);$(KohBuildTasksAssembly);$(KohCompilerExecutable);$(KohLinkExecutable);$(KohRomPropsStampFile)"
          Outputs="$(KohRomPath);$(KohObjectPath);$(KohKdbgOutput)">
    <CompileKohRom OutputPath="$(KohRomPath)" ObjectPath="$(KohObjectPath)" ProjectDirectory="$(MSBuildProjectDirectory)"
                   AssemblyPath="$(TargetPath)" ReferencePaths="@(ReferencePath)"
                   CgbCompatible="$(KohCgbCompatible)" CgbOnly="$(KohCgbOnly)" EmitDebugInfo="$(KohEmitDebugInfo)"
                   CompilerPath="$(KohCompilerExecutable)" LinkerPath="$(KohLinkExecutable)" />
    <ItemGroup>
      <FileWrites Include="$(KohRomPath);$(KohObjectPath)" />
      <FileWrites Condition="'$(KohEmitDebugInfo)' == 'true'" Include="$(KohKdbgPath)" />
    </ItemGroup>
  </Target>
</Project>
